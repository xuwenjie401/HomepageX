---
import Layout from '../../layouts/Layout.astro';
import PostArchive from '../../components/PostArchive.astro';
import { blogSeries } from '../../lib/blog-series';
import { withBase } from '../../config';
import { getPosts } from '../../lib/posts';
const posts = await getPosts();
---
<Layout title="文章" description="学习笔记、实践记录与日常发现。">
  <header class="page-heading">
    <span class="eyebrow">THE JOURNAL</span>
    <h1>文章与记录<span class="accent">。</span></h1>
    <p>把零散的思考，慢慢整理成自己的文字。</p>
  </header>
  <PostArchive posts={posts} hideNested>
    <section id="blog-series" class="series-list" aria-label="文章专题">
      {blogSeries.map(series => (
        <a class="series-card" href={withBase(`blog/${series.slug}/`)}>
          <div class="series-meta"><span>专题目录</span><span>{posts.filter(post => post.id.startsWith(`${series.slug}/`)).length} 篇文章</span></div>
          <h2><span lang="en">{series.title}</span><span aria-hidden="true">↗</span></h2>
          <p>{series.description}</p>
        </a>
      ))}
    </section>
  </PostArchive>
</Layout>
