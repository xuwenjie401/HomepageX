---
import Layout from '../../../layouts/Layout.astro';
import PostArchive from '../../../components/PostArchive.astro';
import { ariaPerceptionSeries as series } from '../../../lib/blog-series';
import { getPosts } from '../../../lib/posts';
import { withBase } from '../../../config';
const posts = (await getPosts())
  .filter(post => post.id.startsWith(`${series.slug}/`))
  .sort((a, b) => series.order.indexOf(a.id.split('/').pop()!) - series.order.indexOf(b.id.split('/').pop()!));
---
<Layout title={series.title} description={series.description}>
  <header class="page-heading series-heading">
    <a class="text-link back-link" href={withBase('blog/')}>← 所有文章</a>
    <h1 lang="en">{series.title}</h1>
    <p>{series.description}</p>
    <p class="series-intro">按阅读顺序排列 · BoxerNet → LAMP → HMD² → EgoForce → Photoreal Reconstruction</p>
  </header>
  <PostArchive posts={posts} />
</Layout>
