---
import Layout from '../layouts/Layout.astro';
import { site, withBase } from '../config';

const portals = [
  { label: '博客', sub: 'WORDS', rune: 'ᚹ', path: 'blog/', angle: 0, counter: 0 },
  { label: '摄影', sub: 'LIGHT', rune: 'ᛚ', path: 'photography/', angle: 120, counter: -120 },
  { label: '项目', sub: 'WORKS', rune: 'ᛈ', path: 'projects/', angle: 240, counter: -240 },
];
---
<Layout immersive title="秘法档案" description={`${site.name} 的个人主页、博客、摄影与项目记录。`}>
  <section class="portal-home" aria-labelledby="portal-title">
    <div class="portal-noise" aria-hidden="true"></div>
    <div class="portal-stars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <div class="portal-copy">
      <span class="portal-kicker"><b></b> THE PERSONAL SANCTUM · 001</span>
      <h1 id="portal-title">打开我的<br /><em>秘法档案</em></h1>
      <p>文字、光影与正在发生的事，<br />都在这里留下一个入口。</p>
    </div>

    <div class="portal-stage" data-portal-stage>
      <div class="portal-aura" aria-hidden="true"></div>
      <div class="portal-rings" aria-hidden="true">
        <span class="portal-ring ring-outer"></span>
        <span class="portal-ring ring-middle"></span>
        <span class="portal-ring ring-inner"></span>
        <span class="portal-glyphs glyphs-outer">ᚠ · ᚱ · ᚦ · ᚨ · ᚷ · ᚹ · ᚺ · ᚾ · ᛃ · ᛇ · ᛈ · ᛉ</span>
        <span class="portal-glyphs glyphs-inner">✦　ᛟ　✦　ᛞ　✦　ᛏ　✦　ᛒ　✦　ᛗ　✦　ᛋ</span>
      </div>
      <canvas class="portal-sparks" data-portal-canvas aria-hidden="true"></canvas>
      <div class="portal-core" aria-hidden="true"><span>✦</span></div>
      <nav class="portal-menu" aria-label="探索入口">
        {portals.map((portal) => (
          <a class="portal-rune" href={withBase(portal.path)} data-portal-link={portal.label} style={`--angle:${portal.angle}deg;--counter-angle:${portal.counter}deg`}>
            <span class="rune-seal" aria-hidden="true">{portal.rune}</span>
            <span class="rune-label">{portal.label}</span>
            <span class="rune-sub">{portal.sub}</span>
          </a>
        ))}
      </nav>
      <p class="portal-hint"><span>⌁</span> 选择一个符文，开启传送 <span>⌁</span></p>
    </div>

    <div class="portal-bottomline"><span>ARCHIVE OF {site.name.toUpperCase()}</span><span>SCROLL TO EXPLORE <b>↓</b></span><span>NO. 2026 / ONLINE</span></div>
    <p class="portal-status" data-portal-status role="status" aria-live="polite"></p>
  </section>
</Layout>

<script>
  const stage = document.querySelector<HTMLElement>('[data-portal-stage]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-portal-canvas]');
  const status = document.querySelector<HTMLElement>('[data-portal-status]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-portal-link]'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let opening = false;
  let particles: Array<{ angle: number; radius: number; size: number; speed: number; life: number; alpha: number; }> = [];

  function resizeCanvas() {
    if (!stage || !canvas) return;
    const size = stage.getBoundingClientRect().width;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = size * dpr; canvas.height = size * dpr;
    canvas.style.width = `${size}px`; canvas.style.height = `${size}px`;
  }
  function seedParticles(count = 60) {
    particles = Array.from({ length: count }, () => ({ angle: Math.random() * Math.PI * 2, radius: 25 + Math.random() * 10, size: .7 + Math.random() * 2.2, speed: .002 + Math.random() * .009, life: Math.random(), alpha: .25 + Math.random() * .75 }));
  }
  function drawSparks() {
    if (!canvas || !stage) return;
    const context = canvas.getContext('2d'); if (!context) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2); const size = stage.getBoundingClientRect().width; const scale = size / 480;
    context.clearRect(0, 0, canvas.width, canvas.height); context.save(); context.scale(dpr, dpr);
    for (const spark of particles) {
      spark.angle += spark.speed * (opening ? 2.7 : 1); spark.life += opening ? .014 : .004;
      if (spark.life > 1) { spark.life = 0; spark.angle = Math.random() * Math.PI * 2; spark.radius = opening ? 116 + Math.random() * 112 : 160 + Math.random() * 40; }
      const radius = (spark.radius + Math.sin(performance.now() / 800 + spark.angle) * 3) * scale;
      const x = size / 2 + Math.cos(spark.angle) * radius; const y = size / 2 + Math.sin(spark.angle) * radius;
      context.beginPath(); context.fillStyle = `rgba(255, ${opening ? 94 + Math.round(Math.random() * 75) : 157}, 37, ${Math.sin(spark.life * Math.PI) * spark.alpha})`;
      context.shadowColor = '#ff5a19'; context.shadowBlur = (opening ? 9 : 4) * scale; context.arc(x, y, spark.size * (opening ? 1.2 : .75) * scale, 0, Math.PI * 2); context.fill();
    }
    context.restore(); if (!reduceMotion) requestAnimationFrame(drawSparks);
  }
  function openPortal(link: HTMLAnchorElement) {
    if (opening || !stage) return;
    opening = true; stage.dataset.selected = link.dataset.portalLink || ''; document.body.classList.add('portal-opening');
    particles = Array.from({ length: 180 }, () => ({ angle: Math.random() * Math.PI * 2, radius: 105 + Math.random() * 150, size: .7 + Math.random() * 2.8, speed: .006 + Math.random() * .02, life: Math.random(), alpha: .45 + Math.random() * .55 }));
    if (status) status.textContent = `正在开启${link.dataset.portalLink}传送门`;
    window.setTimeout(() => { window.location.href = link.href; }, reduceMotion ? 120 : 1450);
  }
  if (stage && canvas) {
    resizeCanvas(); seedParticles(); drawSparks(); window.addEventListener('resize', resizeCanvas);
    links.forEach((link) => link.addEventListener('click', (event) => { event.preventDefault(); openPortal(link); }));
  }
</script>
