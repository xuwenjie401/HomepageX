---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { site, withBase } from '../config';
import { getPosts } from '../lib/posts';
const posts = (await getPosts()).slice(0, 3);
---
<Layout>
  <section class="hero">
    <div class="eyebrow"><span class="status-dot"></span> A PERSONAL CORNER OF THE INTERNET</div>
    <p class="hello">你好，我是 {site.name}。</p>
    <h1>把想法写下来，<br />让好奇心<span class="accent">有迹可循。</span></h1>
    <p class="hero-description">{site.description}<br />这里是我的个人主页，也是一本不断更新的笔记。</p>
    <div class="hero-links">
      <a class="button" href={withBase('blog/')}>阅读文章 <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={withBase('about/')}>更多关于我 <span aria-hidden="true">→</span></a>
    </div>
    <span class="hero-note" aria-hidden="true">WORDS · IDEAS · MOMENTS</span>
  </section>
  <section class="recent-posts" aria-labelledby="recent-title">
    <div class="section-heading">
      <div><span class="eyebrow">THE JOURNAL</span><h2 id="recent-title">最近写下的</h2></div>
      <a class="text-link" href={withBase('blog/')}>全部文章 <span aria-hidden="true">→</span></a>
    </div>
    {posts.length ? posts.map(post => <PostCard post={post} />) : <p class="empty-state">第一篇文章正在酝酿中。</p>}
  </section>
  <aside class="closing-note"><span aria-hidden="true">✳</span><p>一些想法，一些实践，还有值得记住的瞬间。</p></aside>
</Layout>

