---
import Layout from '../layouts/Layout.astro';
import { site, withBase } from '../config';
import '../styles/gravity.css';

const entries = [
  { label: '博客', english: 'JOURNAL', path: 'blog/' },
  { label: '项目', english: 'PROJECTS', path: 'projects/' },
  { label: '摄影', english: 'PHOTOGRAPHY', path: 'photography/' },
];
const background = withBase('media/gravity-reference.png');
---
<Layout immersive title="时空档案" description={`${site.name} 的个人主页：文字、项目与摄影。`}>
  <link slot="head" rel="preload" as="image" href={background} fetchpriority="high" />
  <section class="gravity-home" data-gravity data-state="flowing" aria-label="黑洞与时空档案">
    <div class="gravity-scene" aria-hidden="true">
      <img class="gravity-poster" src={background} width="1672" height="941" alt="" fetchpriority="high" decoding="sync" />
      <canvas class="gravity-canvas" data-gravity-canvas data-source={background}></canvas>
    </div>
    <div class="gravity-shade" aria-hidden="true"></div>

    <button class="entry-trigger" data-enter aria-label="让画面静止，显示博客、项目和摄影入口">
      <span class="entry-hint"><span class="hint-line" aria-hidden="true"></span>点击或滚动，进入<span class="hint-en" lang="en">ENTER THE STILLNESS</span></span>
    </button>

    <div class="gravity-archive" data-archive inert>
      <p class="archive-eyebrow">A PERSONAL UNIVERSE <span aria-hidden="true">/</span> 01</p>
      <h1>{site.name}<span class="name-dot">.</span></h1>
      <p class="archive-description">记录思考，构建想法，收藏光影。</p>
      <nav class="archive-entries" aria-label="探索我的档案">
        {entries.map((entry, index) => (
          <a class="archive-entry" href={withBase(entry.path)}>
            <span class="entry-number" aria-hidden="true">0{index + 1}</span>
            <span class="entry-label">{entry.label}</span>
            <span class="entry-english" lang="en">{entry.english}</span>
            <span class="entry-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
      <div class="archive-footnote"><span>文字 · 创造 · 目光</span><button data-replay class="replay" aria-label="重新播放黑洞动画">让时间继续 <span aria-hidden="true">↻</span></button></div>
    </div>
    <p class="sr-only" data-gravity-status aria-live="polite"></p>
  </section>
  <noscript><style>.entry-trigger{display:none}.gravity-archive{opacity:1;visibility:visible;transform:none}.gravity-shade{opacity:1}.replay{display:none}</style><p class="gravity-noscript">请启用 JavaScript 观看动态画面。<a href={withBase('blog/')}>博客</a> · <a href={withBase('projects/')}>项目</a> · <a href={withBase('photography/')}>摄影</a></p></noscript>
</Layout>
<script>
  import { initGravityHome } from '../scripts/gravity-home';
  initGravityHome();
</script>
